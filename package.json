{
  "name": "pi-web-client",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "npm run build && node bridge/dist/index.js",
    "start:nobuild": "node bridge/dist/index.js",
    "build": "node scripts/build.mjs",
    "build:bridge": "node scripts/build.mjs --only bridge",
    "build:peer": "node scripts/build.mjs --only peer",
    "build:web": "node scripts/build.mjs --only web",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "npm --prefix bridge run typecheck && npm --prefix peer run typecheck && npm --prefix web run typecheck",
    "test": "node bridge/tests/e2e.mjs",
    "test:rpc": "node bridge/tests/write-after-end.mjs",
    "test:ask": "node --experimental-transform-types bridge/tests/ask-unit.mjs && node bridge/tests/ask-e2e.mjs",
    "test:ask:ui": "node bridge/tests/ask-ui.mjs",
    "test:scratch": "node bridge/tests/scratch-dirs.mjs && node bridge/tests/scratch-chat.mjs",
    "test:scratch:ui": "node bridge/tests/scratch-ui.mjs",
    "test:pillbar": "node --experimental-transform-types web/tests/pillbar-unit.mjs",
    "test:dirpath": "node --experimental-transform-types web/tests/dirpath-unit.mjs",
    "test:commands": "node --experimental-transform-types web/tests/commands-unit.mjs",
    "test:models": "node bridge/tests/models-unit.mjs",
    "test:stat": "node bridge/tests/stat-path.mjs",
    "test:mk": "node bridge/tests/mk-file.mjs",
    "test:nowchip": "node --experimental-transform-types web/tests/nowchip-unit.mjs",
    "test:wsmanage": "node --experimental-transform-types web/tests/wsmanage-unit.mjs",
    "test:defaults": "node --experimental-transform-types bridge/tests/settings-defaults.mjs",
    "test:permission": "node bridge/tests/default-permission.mjs",
    "test:pending": "node --experimental-transform-types web/tests/pending-unit.mjs",
    "test:continue": "node --experimental-transform-types web/tests/continue-unit.mjs",
    "test:failures": "node --experimental-transform-types web/tests/failures-unit.mjs",
    "test:continue:ui": "node bridge/tests/continue-ui.mjs",
    "test:attach:ui": "node bridge/tests/attach-picker.mjs",
    "test:done": "node bridge/tests/done-persist.mjs",
    "test:skillblock": "node bridge/tests/skill-block.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
