{
  "name": "pi-web-client",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/bootstrap.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "start": "node scripts/bootstrap.mjs --start && npm run build && node bridge/dist/index.js",
    "start:nobuild": "node bridge/dist/index.js",
    "build": "node scripts/build.mjs",
    "build:bridge": "node scripts/build.mjs --only bridge",
    "build:peer": "node scripts/build.mjs --only peer",
    "build:web": "node scripts/build.mjs --only web",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "npm --prefix bridge run typecheck && npm --prefix peer run typecheck && npm --prefix web run typecheck",
    "test": "node bridge/tests/e2e.mjs",
    "test:rpc": "node bridge/tests/write-after-end.mjs",
    "test:ask": "node --experimental-strip-types bridge/tests/ask-unit.mjs && node bridge/tests/ask-e2e.mjs",
    "test:context": "node --experimental-transform-types --test bridge/tests/context-log-unit.mjs && node --experimental-transform-types --test web/tests/context-unit.mjs && node --experimental-strip-types --test web/tests/chrome-unit.mjs",
    "test:artifacts": "node bridge/tests/artifacts-unit.mjs && node bridge/tests/artifacts-e2e.mjs",
    "test:ask:ui": "node bridge/tests/ask-ui.mjs",
    "test:ask-tab": "node --experimental-strip-types web/tests/ask-tab-unit.mjs",
    "test:ask-card": "node --experimental-strip-types web/tests/ask-card-unit.mjs",
    "test:ask-tab:ui": "node bridge/tests/ask-tab-ui.mjs",
    "test:exec-panel:ui": "node bridge/tests/exec-panel-ui.mjs",
    "test:exec-plan": "node --experimental-strip-types web/tests/exec-view-unit.mjs && node bridge/tests/plan-nudge-unit.mjs && npm run build:bridge && node bridge/tests/exec-plan-e2e.mjs",
    "test:preview": "node bridge/tests/preview-tool.mjs && node --experimental-strip-types bridge/tests/open-preview-unit.mjs",
    "test:translate": "node --experimental-strip-types bridge/tests/translate-unit.mjs && node --experimental-strip-types web/tests/translateview-unit.mjs",
    "test:translate:e2e": "npm run build:bridge && node bridge/tests/translate-e2e.mjs",
    "test:image": "node --experimental-strip-types bridge/tests/session-image-unit.mjs && node bridge/tests/session-image.mjs",
    "test:slides": "node --experimental-strip-types bridge/tests/slides-unit.mjs",
    "test:scratch": "node bridge/tests/scratch-dirs.mjs && node bridge/tests/scratch-chat.mjs",
    "test:scratch:ui": "node bridge/tests/scratch-ui.mjs",
    "test:pillbar": "node --experimental-strip-types web/tests/pillbar-unit.mjs",
    "test:dirpath": "node --experimental-strip-types web/tests/dirpath-unit.mjs",
    "test:commands": "node --experimental-strip-types web/tests/commands-unit.mjs",
    "test:jira": "node bridge/tests/jira-search-unit.mjs && node bridge/tests/jira-e2e.mjs && node web/tests/jira-unit.mjs",
    "test:skill": "node bridge/tests/skill-implicit.mjs",
    "test:models": "node bridge/tests/models-unit.mjs",
    "test:stat": "node bridge/tests/stat-path.mjs",
    "test:mk": "node bridge/tests/mk-file.mjs",
    "test:nowchip": "node --experimental-strip-types web/tests/nowchip-unit.mjs",
    "test:exec-view": "node --experimental-strip-types web/tests/exec-view-unit.mjs",
    "test:wsmanage": "node --experimental-strip-types web/tests/wsmanage-unit.mjs",
    "test:menuplace": "node --experimental-strip-types web/tests/menuplace-unit.mjs",
    "test:defaults": "node --experimental-strip-types bridge/tests/settings-defaults.mjs",
    "test:permission": "node bridge/tests/default-permission.mjs",
    "test:pending": "node --experimental-strip-types web/tests/pending-unit.mjs",
    "test:continue": "node --experimental-strip-types web/tests/continue-unit.mjs",
    "test:bgruns": "node --experimental-strip-types bridge/tests/bgruns-unit.mjs",
    "test:whatsnew": "node --experimental-strip-types bridge/tests/whatsnew-unit.mjs",
    "test:sysmanage": "node bridge/tests/sysmanage-unit.mjs && node web/tests/sysmanage-unit.mjs",
    "test:sysmanage:ui": "node bridge/tests/sysmanage-ui.mjs",
    "test:settings": "node web/tests/settings-console-unit.mjs",
    "test:settings:ui": "node bridge/tests/settings-console-ui.mjs",
    "test:whatsnew:ui": "node bridge/tests/whatsnew-ui.mjs",
    "test:tunnel": "node --experimental-strip-types bridge/tests/tunnel-unit.mjs && node --experimental-strip-types web/tests/tunnel-snapshot-unit.mjs",
    "test:tunnel:ui": "node bridge/tests/tunnel-ui.mjs",
    "test:extwidgets": "node --experimental-strip-types bridge/tests/extwidgets-unit.mjs",
    "test:failures": "node --experimental-strip-types web/tests/failures-unit.mjs",
    "test:failcta:ui": "node bridge/tests/fail-cta-ui.mjs",
    "test:continue:ui": "node bridge/tests/continue-ui.mjs",
    "test:attach:ui": "node bridge/tests/attach-picker.mjs",
    "test:done": "node bridge/tests/done-persist.mjs",
    "test:skillblock": "node bridge/tests/skill-block.mjs",
    "test:lessons": "node --experimental-strip-types bridge/tests/lessons-unit.mjs",
    "test:hint": "node bridge/tests/hint-spawn.mjs",
    "test:rules": "node --experimental-strip-types web/tests/rules-unit.mjs && node --experimental-strip-types bridge/tests/rules-unit.mjs",
    "test:probes": "node web/tests/probes-unit.mjs",
    "test:peer": "node bridge/tests/peer-e2e.mjs && node bridge/tests/peer-history.mjs",
    "test:peer:ui": "node bridge/tests/peer-ui.mjs",
    "probe:workspace": "node probes/run-all.mjs",
    "probe:chrome": "node probes/run-all.mjs --only chrome-topbar,chrome-bottom,chrome-sheet,chrome-narrow",
    "probe:preview": "node probes/preview-open.mjs",
    "probe:translate": "node probes/translate-ui.mjs",
    "probe:extstore": "node probes/ext-store-paint.mjs",
    "test:history": "node --experimental-strip-types bridge/tests/history-page-unit.mjs",
    "test:head": "node --experimental-strip-types bridge/tests/session-head-unit.mjs",
    "test:paging": "node bridge/tests/paging-scope.mjs",
    "test:paging:ui": "node bridge/tests/paging-local-ui.mjs",
    "test:history:ui": "node bridge/tests/history-paths-ui.mjs",
    "test:loadolder:ui": "node --experimental-strip-types bridge/tests/history-ui.mjs",
    "test:tail": "node --experimental-strip-types bridge/tests/tail-read-error.mjs",
    "test:stateguard": "node --experimental-strip-types bridge/tests/state-read-guard.mjs",
    "test:githist": "node --experimental-strip-types bridge/tests/git-history-unit.mjs && node --experimental-strip-types bridge/tests/gitops-unit.mjs && node --experimental-strip-types bridge/tests/git-probe-unit.mjs",
    "test:githist:ui": "node bridge/tests/git-history-ui.mjs",
    "test:subagents": "node --experimental-strip-types bridge/tests/subagents-unit.mjs && node --experimental-strip-types bridge/tests/subagents-basics-unit.mjs && node --experimental-strip-types bridge/tests/subagents-overrides-unit.mjs && node --experimental-strip-types bridge/tests/subagents-advanced-unit.mjs && node --experimental-strip-types bridge/tests/acpdelegate-unit.mjs",
    "test:subagents:ui": "node bridge/tests/subagents-overrides-ui.mjs && node bridge/tests/acp-delegate-ui.mjs && node bridge/tests/subagents-advanced-ui.mjs",
    "test:start-check": "node bridge/tests/start-check.mjs",
    "test:deps": "node --experimental-strip-types bridge/tests/deps-unit.mjs",
    "test:pi": "node --experimental-strip-types bridge/tests/pi-candidates-unit.mjs",
    "test:deps:ui": "node bridge/tests/deps-ui.mjs",
    "test:image:ui": "node bridge/tests/session-image-ui.mjs",
    "test:repos:ui": "node bridge/tests/repos-ui.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
